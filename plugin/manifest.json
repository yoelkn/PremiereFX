{
  "manifestVersion": 5,
  "id": "com.local.premierefx",
  "name": "PremiereFX",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "premiereFxPanel",
      "label": { "default": "PremiereFX" },
      "minimumSize": { "width": 160, "height": 60 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 240, "height": 90 },
      "preferredFloatingSize": { "width": 240, "height": 90 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    }
  }
}
